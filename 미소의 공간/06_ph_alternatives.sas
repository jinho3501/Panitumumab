/*==============================================================
  06_ph_alternatives.sas
  목적 : PFS 비례위험 가정 위반에 대한 두 가지 대응 분석
         [A] 구간별 위험비  — 효과가 언제 강한지 숫자로 보이기
         [B] RMST           — 비례위험 가정이 필요 없는 대안 지표

  전제 : 04번 코드 STEP 3 까지 실행되어 work.surv 가 있어야 함

  ----------------------------------------------------------------
  [분석 지위]  본 두 분석은 SAP 에 사전 기술되지 않았으므로
               사후분석(post-hoc)으로 명확히 라벨링한다.
               ICH E9 은 사후분석을 사전계획 분석과 구분하여 보고할
               것을 요구하며, 확증적 근거가 아닌 탐색적 근거로
               해석하도록 한다.

               단, 분할 시점과 tau 는 결과를 보고 고른 값이 아니라
               원 시험 프로토콜의 평가 스케줄에서 가져왔다. 이것이
               사후분석의 신뢰도를 지키는 최소 조건이다.
  ----------------------------------------------------------------
==============================================================*/


/*==============================================================
  [A] 구간별 위험비 (Piecewise Hazard Ratio)
==============================================================*/

/*--------------------------------------------------------------
  A-0. 분할 시점 정하기  --  112일 = week 16

  [근거] 원 시험 프로토콜의 영상 평가 예정 시점을 그대로 사용한다.
         week  8 · 12 · 16 · 24 · 32 · 40 · 48
              (56) (84) (112)(168)(224)(280)(336)일
         이 값들은 시험 설계 시점에 이미 확정된 것으로, 우리 데이터를
         전혀 보지 않고도 정할 수 있다. 즉 데이터 외부에서 온 근거다.

  [왜 이게 중요한가]
   국제기준(ICH E9, EMA PFS 부속지침, FDA 종양학 OS 지침)이 요구하는 것은
   "몇 일로 하라"가 아니라 "데이터를 보기 전에 정하고 바꾸지 말라" 이다.
   따라서 분할 시점의 근거가 결과(진단 그래프 모양, 중앙 PFS 값)에서
   오면 안 되고, 프로토콜처럼 데이터 밖에서 와야 한다.

  [절대 하면 안 되는 것]
   여러 값을 돌려보고 차이가 가장 큰 값을 고르는 것. p-hacking 이다.
   한 번 정했으면 결과가 마음에 안 들어도 바꾸지 않는다.

  [보고서 문구]
   "분할 시점은 원 시험 프로토콜의 영상 평가 예정 시점(week 16, 112일)을
    사용하여 데이터 확인 이전 기준으로 지정하였다."
--------------------------------------------------------------*/
%let cut = 112;   /* week 16 */


/*--------------------------------------------------------------
  A-1. 한 환자를 두 줄로 쪼개기 (counting process 형식)

  원래 데이터는 환자 1명 = 1행 이다. 이걸 구간마다 한 행씩으로
  쪼개서, 같은 환자가 구간 1과 구간 2에 각각 등장하게 만든다.

  예: PFSTIME=150, PFSCR=1 인 환자
      구간1 →  0~100일 살아남음        → 사건 0 (100일에 중도절단)
      구간2 →  100~150일에 진행        → 사건 1

  이렇게 하면 "100일까지의 위험"과 "100일 이후의 위험"을
  따로 추정할 수 있다.
--------------------------------------------------------------*/
data work.split;
  set work.surv;
  where KRASEVAL = 1 and PFSTIME > 0;   /* PFS시간 0인 15명은 구간을 만들 수 없어 제외 */

  /*--- 구간 1 : 0 ~ &cut 일 ---*/
  tstart = 0;
  tstop  = min(PFSTIME, &cut);              /* cut 을 넘겼으면 cut 에서 끊는다 */
  event  = (PFSCR = 1 and PFSTIME <= &cut); /* cut 안에서 일어난 사건만 1 */
  period = 1;
  output;

  /*--- 구간 2 : &cut 일 이후 (cut 을 넘긴 환자만) ---*/
  if PFSTIME > &cut then do;
    tstart = &cut;                          /* 이 환자는 100일부터 관찰 시작 */
    tstop  = PFSTIME;
    event  = (PFSCR = 1);
    period = 2;
    output;
  end;

  label period='관찰 구간' tstart='구간 시작일' tstop='구간 종료일';
run;

/* 쪼개진 결과 확인 : 구간1 행 수 = 환자 수, 구간2 행 수 = cut 을 넘긴 환자 수 */
proc freq data=work.split;
  tables period * event / nopercent nocol;
  title "A-1 검증 — 구간별 행 수와 사건 수 (분할 시점 &cut 일)";
run;


/*--------------------------------------------------------------
  A-2. 구간별로 같은 모형을 따로 적합

  by period;  →  구간 1 결과, 구간 2 결과가 각각 출력된다.

  (tstart, tstop)*event(0) 이라는 문법이 핵심이다.
   - 시작시점과 종료시점을 둘 다 준다는 뜻
   - 구간 2 에서 tstart=100 이라는 것은 "이 환자는 100일까지
     살아남은 사람들 중 하나" 라는 조건을 모형에 알려주는 것이다.
     이걸 안 하면 100일 이후 분석이 편향된다.
--------------------------------------------------------------*/
proc sort data=work.split; by period; run;

proc phreg data=work.split;
  by period;
  class TRTN(ref='0') KRASN(ref='0') / param=ref;
  model (tstart, tstop)*event(0) = TRTN KRASN TRTN*KRASN / rl ties=efron;
  hazardratio '구간별 KRAS 수준별 치료효과' TRTN / at(KRASN=ALL);
  title "A-2 구간별 Cox — period 1: 0~&cut 일 / period 2: &cut 일 이후";
run;
title;


/*==============================================================
  [B] RMST (Restricted Mean Survival Time, 제한평균생존시간)
==============================================================*/

/*--------------------------------------------------------------
  B-0. RMST 가 무엇인가

  "tau 일까지 평균 며칠을 사건 없이 보냈는가"

  Kaplan-Meier 곡선 아래 면적을 tau 시점까지 잘라서 계산한 값이다.
  위험비가 시간에 따라 변하든 말든 상관이 없다. 면적은 그냥 면적이다.
  -> 비례위험 가정이 아예 필요 없다.

  [근거] tau = 168일 = week 24

   (1) 원 시험 프로토콜의 영상 평가 예정 시점이다 (데이터 외부 근거)
   (2) 약 6개월. 6개월 PFS 율은 종양학에서 표준적으로 보고되는 지표다
   (3) 기술적 제약을 만족한다 — tau 는 각 군의 최대 관측시간 중
       작은 값을 넘으면 안 된다. 본 데이터에서 가장 짧은 군도
       400일 이상 관찰되었으므로 168일은 충분히 안쪽이다

  [주의] tau 를 너무 크게 잡으면 관측이 적은 꼬리 구간에 추정이
         의존하게 되어 불안정해진다. 반대로 너무 작으면 치료효과가
         나타나기 전에 잘라버린다. 프로토콜 랜드마크는 이 균형을
         자의적 판단 없이 잡아주는 좋은 기준점이다.

  [FDA 지침 참고] 종양학 OS 지침은 비례위험 위반이 예상될 때
   landmark 생존율과 RMST 를 사전에 지정하도록 권고한다. 즉 RMST 는
   임의로 고른 방법이 아니라 지침에 명시된 표준 대응책이다.
--------------------------------------------------------------*/
%let tau = 168;   /* week 24, 약 6개월 */


/*--------------------------------------------------------------
  B-1. KRAS 하위군별 RMST

  rmst(tau=...) 옵션이 RMST 추정값과 군 간 차이를 출력한다.
  strata TRTN 이 있어야 "차이" 표가 나온다.
--------------------------------------------------------------*/
proc lifetest data=work.surv rmst(tau=&tau) plots=none;
  where KRASN = 0;
  time PFSTIME*PFSCR(0);
  strata TRTN;
  title "B-1 RMST — KRAS Wild-type, tau = &tau 일";
run;

proc lifetest data=work.surv rmst(tau=&tau) plots=none;
  where KRASN = 1;
  time PFSTIME*PFSCR(0);
  strata TRTN;
  title "B-1 RMST — KRAS Mutant, tau = &tau 일";
run;

/* 참고 : 전체 KRAS 평가군 */
proc lifetest data=work.surv rmst(tau=&tau) plots=none;
  where KRASEVAL = 1;
  time PFSTIME*PFSCR(0);
  strata TRTN;
  title "B-1 RMST — KRAS 평가군 전체, tau = &tau 일";
run;
title;


/*--------------------------------------------------------------
  B-2. (선택) RMST 회귀모형 — 상호작용을 직접 검정

  PROC RMSTREG 는 RMST 를 결과변수로 하는 회귀모형이다.
  Cox 와 같은 구조로 상호작용을 넣을 수 있고, 계수는 "일(day)"
  단위로 해석된다.

  [주의] SAS/STAT 15.1 이상에서 사용 가능하다. 로그에
         "프로시저를 찾을 수 없음" 이 뜨면 B-1 만으로 충분하다.
--------------------------------------------------------------*/
proc rmstreg data=work.surv tau=&tau;
  where KRASEVAL = 1;
  class TRTN(ref='0') KRASN(ref='0');
  model PFSTIME*PFSCR(0) = TRTN KRASN TRTN*KRASN / link=linear;
  title "B-2 RMST 회귀 — 상호작용 포함, tau = &tau 일";
run;
title;


/*==============================================================
  결과를 읽는 순서

  [A] 구간별 위험비
    1) A-1 검증표 — 구간 2 행 수가 너무 적지 않은지 확인
    2) A-2 출력에서 period=1 과 period=2 를 각각 찾는다
    3) 각 period 의 'Hazard Ratios' 표에서 At KRASN=0 줄을 본다
    4) 역수를 취한다 (0 vs 1 방향이므로)
    5) 기대 : period 1 의 HR 이 period 2 보다 훨씬 작다
       -> "치료효과는 초기 100일에 집중되고 이후 약화된다"
    6) period 2 는 표본이 줄어 신뢰구간이 넓어진다. 정상이다.

  [B] RMST
    1) 'RMST Estimates' 표 — 군별 평균 무진행 일수
    2) 'RMST Difference' 표 — 차이, 95% CI, p-value
    3) [중요] 판정 기준이 HR 과 다르다
         HR       : 95% CI 가 1 을 포함하는가
         RMST 차이 : 95% CI 가 0 을 포함하는가
    4) Wild-type 에서 차이가 유의하고 Mutant 에서 유의하지 않으면
       Cox 결과와 같은 결론이다 -> 가정 위반과 무관하게 결론 유지
==============================================================*/
